EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (expo-auth-session → Firebase)
# Web client ID — required everywhere (Expo Go proxy + Firebase signInWithCredential).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID — required for TestFlight / App Store builds (NOT the Web client).
# Create in Google Cloud → Credentials → OAuth 2.0 Client ID → Application type: iOS
# Bundle ID: com.whatweeatin.app (must match app.json ios.bundleIdentifier).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android OAuth client ID — optional until you ship Android.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# EAS / TestFlight: local .env is NOT included in cloud builds.
# Sync EXPO_PUBLIC_* to EAS (expo.dev → Environment variables, or CLI):
#   eas env:create --name EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID --value 'YOUR_WEB_ID.apps.googleusercontent.com' --environment production --visibility plaintext --force
#   eas env:create --name EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID --value 'YOUR_IOS_ID.apps.googleusercontent.com' --environment production --visibility plaintext --force
# Or: eas env:push production --path .env --force
# Profiles in eas.json set "environment": "production" | "preview" | "development".
#
# Google Cloud Web client (Expo Go ONLY — do NOT add whatweeatin:// or custom schemes):
#   Authorized JavaScript origins: https://auth.expo.io
#   Authorized redirect URIs:       https://auth.expo.io/@yoavwerdiger/what-we-eatin
# TestFlight / production iOS: separate OAuth client type "iOS" (bundle com.whatweeatin.app).
# Redirect is com.whatweeatin.app:/oauthredirect automatically — no Web client URI needed.

# Ads / AdMob (react-native-google-mobile-ads). Off by default — safe for Expo Go.
# Real ads require a development/production build (not Expo Go). See README → Ads.
EXPO_PUBLIC_ADS_ENABLED=false
# Set true only after: install react-native-google-mobile-ads + EAS/dev client rebuild.
EXPO_PUBLIC_ADS_NATIVE_LINKED=false
# Leave unset/false while developing: uses Google public test unit IDs.
# Set true only with your real AdMob unit IDs in a release build.
EXPO_PUBLIC_ADS_USE_PRODUCTION_IDS=false
# App IDs (also required in app.json for the native plugin — see README).
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
# Banner unit IDs (Google test IDs below; replace for production).
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-3940256099942544/2934735716
